<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Spring Vine Butterfly Loader · Follow Vine Final</title>
  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: transparent;
    }

    body {
      display: grid;
      place-items: center;
    }

    .spring-loader {
      width: 220px;
      height: 220px;
      display: grid;
      place-items: center;
      position: relative;
    }

    canvas {
      width: 220px;
      height: 220px;
      display: block;
    }

    @media (max-width: 480px) {
      .spring-loader,
      canvas {
        width: 180px;
        height: 180px;
      }
    }
  </style>
</head>
<body>
  <div class="spring-loader" aria-label="春日藤蔓蝴蝶加载动画">
    <canvas id="springLoader" width="220" height="220" aria-hidden="true"></canvas>
  </div>

  <script>
    const canvas = document.getElementById('springLoader');
    const ctx = canvas.getContext('2d');

    const W = canvas.width;
    const H = canvas.height;
    const cx = W / 2;
    const cy = H / 2;
    const radius = 64;
    const TAU = Math.PI * 2;

    const COLORS = {
      guideRing: 'rgba(152, 200, 150, 0.07)',
      guideRing2: 'rgba(210, 240, 210, 0.11)',

      vineBaseMain: 'rgba(94, 158, 89, 0.76)',
      vineBaseLight: 'rgba(157, 218, 130, 0.72)',
      vineFlowMain: '#5E9E59',
      vineFlowLight: '#9DDA82',
      vineHighlight: 'rgba(214,255,178,0.82)',
      vineShadow: 'rgba(78,145,80,0.18)',
      tendril: 'rgba(100,170,95,0.42)',

      leaf: ['#6FB96A', '#8ED47B', '#5EAD64', '#A2DD86'],
      grass: ['#7DCA70', '#99DC86', '#67B95C', '#A7E79A', '#86D477'],
      flower: ['#F7AFCF', '#FFD96F', '#AEEFD5', '#EAB8FF', '#FFBDA6'],
      butterfly: ['#F8B4D9', '#FFE58A', '#AEEFD5', '#C6B1FF'],
      pollen: [
        'rgba(255,255,255,0.78)',
        'rgba(255,230,140,0.56)',
        'rgba(185,240,210,0.58)'
      ]
    };

    const rand = (min, max) => Math.random() * (max - min) + min;
    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    // 速度比早期版加快约 20%
    const CYCLE = 3.67;

    // 活跃流动藤蔓段长度
    const ACTIVE_SPAN = TAU * 0.76;

    // 蝴蝶朝藤蔓延伸方向再转 90°
    const BUTTERFLY_ROTATION_OFFSET = Math.PI / 2;

    function pointOnCircle(angle, r = radius) {
      return {
        x: cx + Math.cos(angle) * r,
        y: cy + Math.sin(angle) * r
      };
    }

    function normalAt(angle) {
      return {
        x: Math.cos(angle),
        y: Math.sin(angle)
      };
    }

    function tangentAngle(angle) {
      return angle + Math.PI / 2;
    }

    function butterflyAngle(angle) {
      return tangentAngle(angle) + BUTTERFLY_ROTATION_OFFSET;
    }

    function colorFrom(list, index) {
      return list[index % list.length];
    }

    function createGrassBlades(scale, seed) {
      const blades = [];
      const count = 5 + (seed % 3);

      for (let i = 0; i < count; i++) {
        const t = count === 1 ? 0.5 : i / (count - 1);
        blades.push({
          offset: (t - 0.5) * scale * 1.35,
          length: scale * rand(1.9, 3.0) * (0.92 + Math.sin(t * Math.PI) * 0.14),
          bend: (t - 0.5) * scale * rand(0.55, 1.0),
          width: rand(0.72, 1.0),
          lean: rand(-0.25, 0.25),
          color: colorFrom(COLORS.grass, seed + i)
        });
      }

      return blades;
    }

    // 不再固定整圈位置，改成“挂在活跃藤蔓段上的随行元素”
    function createTrailDecorations() {
      const list = [];
      const count = 16;

      for (let i = 0; i < count; i++) {
        const t = i / (count - 1);
        const roll = Math.random();
        const type = roll > 0.75 ? 'flower' : roll > 0.40 ? 'grass' : 'leaf';
        const size =
          type === 'flower'
            ? rand(3.8, 6.2)
            : type === 'grass'
              ? rand(3.0, 4.6)
              : rand(3.6, 5.8);

        list.push({
          offsetRatio: 0.06 + t * 0.88, // 距离头部的相对位置
          type,
          side: Math.random() > 0.5 ? 1 : -1,
          offset: type === 'grass' ? rand(2.4, 3.8) : rand(4.8, 9.2),
          size,
          rotate: rand(0, TAU),
          sway: rand(0, TAU),
          color:
            type === 'flower'
              ? colorFrom(COLORS.flower, i)
              : type === 'grass'
                ? colorFrom(COLORS.grass, i)
                : colorFrom(COLORS.leaf, i),
          blades: createGrassBlades(size, i)
        });
      }

      return list;
    }

    function createButterflies() {
      return [
        { offsetRatio: 0.10, color: COLORS.butterfly[0], size: 7.0, lane: 5.2, phase: 0.0 },
        { offsetRatio: 0.22, color: COLORS.butterfly[1], size: 6.0, lane: 6.2, phase: 1.4 },
        { offsetRatio: 0.36, color: COLORS.butterfly[2], size: 6.6, lane: 4.7, phase: 2.5 },
        { offsetRatio: 0.52, color: COLORS.butterfly[3], size: 6.3, lane: 5.7, phase: 3.8 },
        { offsetRatio: 0.68, color: COLORS.butterfly[0], size: 5.6, lane: 6.8, phase: 5.0 }
      ];
    }

    function createPollens() {
      const list = [];
      for (let i = 0; i < 14; i++) {
        list.push({
          offsetRatio: 0.08 + (i / 13) * 0.84,
          lane: rand(-9, 15),
          drift: rand(-3, 3),
          size: rand(0.7, 1.6),
          alpha: rand(0.16, 0.38),
          color: colorFrom(COLORS.pollen, i),
          phase: rand(0, TAU)
        });
      }
      return list;
    }

    const trailDecorations = createTrailDecorations();
    const butterflies = createButterflies();
    const pollens = createPollens();

    function drawBaseRing() {
      ctx.save();
      ctx.lineCap = 'round';

      ctx.strokeStyle = COLORS.guideRing;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, TAU);
      ctx.stroke();

      ctx.strokeStyle = COLORS.guideRing2;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(cx, cy, radius + 8, 0, TAU);
      ctx.stroke();

      ctx.restore();
    }

    function getVinePoint(angle, strand, time) {
      const wrap = Math.sin((angle + Math.PI / 2) * 5.2 + strand.phase + time * 0.8) * strand.wave;
      const r = radius + wrap + strand.offset;
      return pointOnCircle(angle, r);
    }

    function drawVinePath(start, end, strand, time, color, width, alpha = 1) {
      const total = Math.max(0.001, end - start);
      const steps = Math.max(12, Math.ceil(total / TAU * 150));

      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.shadowColor = COLORS.vineShadow;
      ctx.shadowBlur = 4;
      ctx.beginPath();

      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const angle = start + total * t;
        const p = getVinePoint(angle, strand, time);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }

      ctx.stroke();
      ctx.restore();
    }

    function drawTaperedVinePath(start, end, strand, time, color, tailWidth, headWidth, alpha = 1) {
      const total = Math.max(0.001, end - start);
      const steps = Math.max(24, Math.ceil(total / TAU * 180));

      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = color;
      ctx.shadowColor = COLORS.vineShadow;
      ctx.shadowBlur = 5;

      let prev = getVinePoint(start, strand, time);

      for (let i = 1; i <= steps; i++) {
        const t = i / steps;
        const angle = start + total * t;
        const curr = getVinePoint(angle, strand, time);

        ctx.lineWidth = tailWidth + (headWidth - tailWidth) * t;
        ctx.beginPath();
        ctx.moveTo(prev.x, prev.y);
        ctx.lineTo(curr.x, curr.y);
        ctx.stroke();

        prev = curr;
      }

      ctx.restore();
    }

    function drawWrapMarks(start, end, time, alpha = 0.7) {
      const span = end - start;
      const count = Math.floor(span / TAU * 22);
      if (count <= 0) return;

      ctx.save();
      ctx.lineCap = 'round';
      ctx.strokeStyle = COLORS.tendril;
      ctx.globalAlpha = alpha;
      ctx.lineWidth = 0.75;
      ctx.shadowColor = 'rgba(145, 220, 125, 0.16)';
      ctx.shadowBlur = 3;

      for (let i = 0; i < count; i++) {
        const angle = start + (span * i) / Math.max(1, count);
        const n = normalAt(angle);
        const p1 = pointOnCircle(angle, radius - 2.4 + Math.sin(time + i) * 0.35);
        const p2 = pointOnCircle(angle, radius + 2.4 + Math.cos(time + i) * 0.35);
        const bend = pointOnCircle(angle + 0.018, radius + Math.sin(i) * 2.0);

        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.quadraticCurveTo(bend.x + n.x * 1.6, bend.y + n.y * 1.6, p2.x, p2.y);
        ctx.stroke();
      }

      ctx.restore();
    }

    function drawLeaf(x, y, angle, size, color, alpha = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = color;

      ctx.beginPath();
      ctx.moveTo(0, -size);
      ctx.quadraticCurveTo(size * 0.82, -size * 0.22, 0, size);
      ctx.quadraticCurveTo(-size * 0.82, -size * 0.22, 0, -size);
      ctx.fill();

      ctx.strokeStyle = 'rgba(255,255,255,0.32)';
      ctx.lineWidth = 0.7;
      ctx.beginPath();
      ctx.moveTo(0, -size * 0.66);
      ctx.lineTo(0, size * 0.66);
      ctx.stroke();

      ctx.restore();
    }

    function drawFlower(x, y, size, rotation, color, alpha = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.globalAlpha = alpha;
      ctx.shadowColor = color;
      ctx.shadowBlur = 5;

      for (let i = 0; i < 5; i++) {
        ctx.rotate(TAU / 5);
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.ellipse(0, -size, size * 0.34, size * 0.82, 0, 0, TAU);
        ctx.fill();
      }

      ctx.shadowBlur = 0;
      ctx.fillStyle = 'rgba(255,255,255,0.92)';
      ctx.beginPath();
      ctx.arc(0, 0, size * 0.23, 0, TAU);
      ctx.fill();

      ctx.restore();
    }

    function drawGrassBlade(offset, length, bend, width, color) {
      const baseY = 0;
      const tipX = offset + bend;
      const tipY = -length;
      const midX = offset + bend * 0.35;
      const midY = -length * 0.48;
      const bladeWidth = width;

      ctx.beginPath();
      ctx.moveTo(offset - bladeWidth, baseY);
      ctx.quadraticCurveTo(midX - bladeWidth * 0.4, midY, tipX, tipY);
      ctx.quadraticCurveTo(midX + bladeWidth * 0.65, midY + 1, offset + bladeWidth, baseY);
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();
    }

    function drawGrassTuft(x, y, circleAngle, side, scale, blades, alpha = 1, time = 0) {
      const outward = circleAngle + (side > 0 ? 0 : Math.PI);
      const rot = outward + Math.PI / 2;

      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rot);
      ctx.globalAlpha = alpha;
      ctx.shadowColor = 'rgba(110, 180, 100, 0.10)';
      ctx.shadowBlur = 2;

      for (const blade of blades) {
        const sway = Math.sin(time * 1.8 + blade.lean * 8) * scale * 0.09;
        drawGrassBlade(
          blade.offset,
          blade.length * (0.97 + Math.sin(time + blade.offset) * 0.03),
          blade.bend + sway,
          blade.width,
          blade.color
        );
      }

      ctx.fillStyle = 'rgba(255,255,255,0.09)';
      ctx.beginPath();
      ctx.ellipse(0, 0, scale * 0.64, scale * 0.18, 0, 0, TAU);
      ctx.fill();

      ctx.restore();
    }

    function drawButterfly(x, y, size, rotation, color, alpha = 1, ghost = false, time = 0) {
      const flap = ghost ? 1 : 1 + Math.sin(time * 12) * 0.10;

      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = color;

      ctx.beginPath();
      ctx.ellipse(-size * 0.52, -size * 0.08, size * 0.50 * flap, size * 0.76, -0.72, 0, TAU);
      ctx.ellipse(size * 0.52, -size * 0.08, size * 0.50 * flap, size * 0.76, 0.72, 0, TAU);
      ctx.fill();

      if (!ghost) {
        ctx.fillStyle = 'rgba(255,255,255,0.35)';
        ctx.beginPath();
        ctx.ellipse(-size * 0.32, -size * 0.16, size * 0.16 * flap, size * 0.30, -0.72, 0, TAU);
        ctx.ellipse(size * 0.32, -size * 0.16, size * 0.16 * flap, size * 0.30, 0.72, 0, TAU);
        ctx.fill();

        ctx.fillStyle = 'rgba(70,80,60,0.44)';
        ctx.fillRect(-0.6, -size * 0.56, 1.2, size * 1.08);
      }

      ctx.restore();
    }

    function drawClosedLoopVine(headAngle, time) {
      const baseStart = -Math.PI / 2;
      const baseEnd = baseStart + TAU;

      const activeStart = headAngle - ACTIVE_SPAN;
      const activeEnd = headAngle;

      const main = { offset: 0, wave: 2.4, phase: 0 };
      const secondary = { offset: 0, wave: 2.6, phase: Math.PI };
      const highlight = { offset: -1.15, wave: 1.55, phase: 0.7 };

      // 完整闭环藤蔓底层
      drawVinePath(baseStart, baseEnd, main, time, COLORS.vineBaseMain, 2.35, 0.96);
      drawVinePath(baseStart, baseEnd, secondary, time, COLORS.vineBaseLight, 1.22, 0.94);
      drawWrapMarks(baseStart, baseEnd, time, 0.24);

      // 流动活跃段：尾细头粗
      drawTaperedVinePath(activeStart, activeEnd, main, time, COLORS.vineFlowMain, 1.6, 3.36, 0.98);
      drawTaperedVinePath(activeStart, activeEnd, secondary, time, COLORS.vineFlowLight, 0.95, 2.00, 0.88);
      drawTaperedVinePath(activeStart, activeEnd, highlight, time, COLORS.vineHighlight, 0.45, 1.00, 0.92);
      drawWrapMarks(activeStart, activeEnd, time, 0.82);

      const tip = getVinePoint(activeEnd, main, time);
      drawLeaf(tip.x, tip.y, tangentAngle(activeEnd) + 0.52, 5.67, '#A2E680', 0.94);
    }

    // 花草叶子跟着活跃藤蔓段一起移动
    function drawTrailDecorations(headAngle, time) {
      for (const item of trailDecorations) {
        const angle = headAngle - ACTIVE_SPAN * item.offsetRatio;

        // 靠近头部更明显，靠近尾巴略弱
        const strength = 1 - item.offsetRatio;
        const appear = clamp(0.35 + strength * 0.85, 0, 1);
        const pulse = 0.92 + Math.sin(time * 1.5 + item.sway) * 0.04;

        const strand = { offset: 0, wave: 2.1, phase: item.side > 0 ? 0 : Math.PI };
        const base = getVinePoint(angle, strand, time);
        const normal = normalAt(angle);
        const sway = Math.sin(time * 1.8 + item.sway) * 0.28;

        const x = base.x + normal.x * item.side * (item.offset + sway);
        const y = base.y + normal.y * item.side * (item.offset + sway);

        const alpha = 0.38 + appear * 0.46;
        const scale = item.size * (0.88 + appear * 0.16) * pulse;

        if (item.type === 'flower') {
          drawFlower(x, y, scale, item.rotate + time * 0.12, item.color, alpha);
        } else if (item.type === 'grass') {
          drawGrassTuft(
            x,
            y,
            angle,
            item.side,
            scale,
            item.blades,
            alpha * 0.95,
            time + item.sway
          );
        } else {
          drawLeaf(x, y, tangentAngle(angle) + item.side * 1.02, scale, item.color, alpha);
        }
      }
    }

    // 蝴蝶也跟着活跃藤蔓段移动
    function drawButterflies(headAngle, time) {
      for (let i = 0; i < butterflies.length; i++) {
        const butterfly = butterflies[i];
        const angle = headAngle - ACTIVE_SPAN * butterfly.offsetRatio;
        const appear = clamp(1 - butterfly.offsetRatio * 0.65, 0.35, 1);

        const r = radius + butterfly.lane + Math.sin(time * 1.4 + butterfly.phase) * 1.0;
        const position = pointOnCircle(angle, r);
        const depth = (Math.sin(angle) + 1) / 2;
        const size = butterfly.size * (0.80 + depth * 0.20);
        const alpha = (0.58 + depth * 0.24) * appear;

        for (let g = 3; g >= 1; g--) {
          const ghostAngle = angle - g * 0.024;
          const ghostPos = pointOnCircle(ghostAngle, r);
          drawButterfly(
            ghostPos.x,
            ghostPos.y,
            size * (1 - g * 0.08),
            butterflyAngle(ghostAngle),
            butterfly.color,
            0.040 * (4 - g) * appear,
            true,
            time + butterfly.phase
          );
        }

        drawButterfly(
          position.x,
          position.y,
          size,
          butterflyAngle(angle),
          butterfly.color,
          alpha,
          false,
          time + butterfly.phase
        );
      }
    }

    // 花粉也跟着活跃段走，不固定满圈
    function drawTrailPollens(headAngle, time) {
      ctx.save();
      ctx.globalCompositeOperation = 'lighter';

      for (const pollen of pollens) {
        const angle = headAngle - ACTIVE_SPAN * pollen.offsetRatio + Math.sin(time * 0.8 + pollen.phase) * 0.015;
        const r = radius + pollen.lane + Math.sin(time * 1.6 + pollen.phase) * 1.8 + pollen.drift * 0.15;
        const p = pointOnCircle(angle, r);
        const alpha = pollen.alpha * (0.62 + Math.sin(time * 2.1 + pollen.phase) * 0.22);

        ctx.fillStyle = pollen.color;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(p.x, p.y, pollen.size, 0, TAU);
        ctx.fill();
      }

      ctx.restore();
      ctx.globalAlpha = 1;
    }

    function drawCenterBud(time) {
      const pulse = 1 + Math.sin(time * 2) * 0.045;

      ctx.save();
      ctx.translate(cx, cy);

      ctx.fillStyle = 'rgba(255,255,255,0.86)';
      ctx.beginPath();
      ctx.arc(0, 0, 6.5 * pulse, 0, TAU);
      ctx.fill();

      ctx.strokeStyle = 'rgba(170,220,170,0.32)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(0, 0, 11.5 * pulse, 0, TAU);
      ctx.stroke();

      drawFlower(0, 0, 4.1 * pulse, time * 0.20, '#F7EFA8', 0.72);

      ctx.restore();
    }

    function runSelfTests() {
      console.assert(canvas instanceof HTMLCanvasElement, 'canvas should exist');
      console.assert(ctx, 'canvas context should exist');
      console.assert(trailDecorations.length === 16, 'trail decorations should exist');
      console.assert(butterflies.length === 5, 'butterflies should exist');
      console.assert(pollens.length === 14, 'pollens should exist');
      console.assert(typeof drawClosedLoopVine === 'function', 'drawClosedLoopVine should exist');
      console.assert(typeof drawTrailDecorations === 'function', 'drawTrailDecorations should exist');
      console.assert(typeof drawButterflies === 'function', 'drawButterflies should exist');
    }

    function animate(ms) {
      const time = ms * 0.001;
      ctx.clearRect(0, 0, W, H);

      const headAngle = -Math.PI / 2 + (time / CYCLE) * TAU;

      drawBaseRing();
      drawClosedLoopVine(headAngle, time);
      drawTrailDecorations(headAngle, time);
      drawTrailPollens(headAngle, time);
      drawButterflies(headAngle, time);
      drawCenterBud(time);

      requestAnimationFrame(animate);
    }

    runSelfTests();
    requestAnimationFrame(animate);
  </script>
</body>
</html>