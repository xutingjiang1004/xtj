{
  "mcpServers": {
    "supabase": {
      "label": "Supabase 数据库",
      "description": "AI 驱动的 Supabase 项目管理 — 数据库查询、表结构、Edge Functions、日志、分支管理等",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "sb_publishable_RFqxlLe3nKnbs_PUHrJjpg_AUVaOGbu"
      ]
    },
    "xtj-admin": {
      "label": "XTJ 管理后台",
      "description": "AI 驱动的 XTJ 管理后台控制 — 用户管理、内容管理、安全中心、数据统计、举报处理等 30+ 操作",
      "command": "node",
      "args": ["${workspaceFolder}/mcp-servers/xtj-admin/server.js"],
      "env": {
        "XTJ_API_BASE": "https://xtj.onrender.com"
      }
    },
    "xtj-image": {
      "label": "XTJ 图片优化",
      "description": "AI 驱动的图片优化 — 压缩/格式转换(WebP/AVIF)/缩放/批量优化/缩略图生成",
      "command": "node",
      "args": ["${workspaceFolder}/mcp-servers/xtj-image/server.js"]
    },
    "xtj-email": {
      "label": "XTJ 邮件通知",
      "description": "AI 驱动的邮件发送 — QQ 邮箱 SMTP，安全警报、通知等",
      "command": "node",
      "args": ["${workspaceFolder}/mcp-servers/xtj-email/server.js"],
      "env": {
        "EMAIL_PROVIDER": "smtp",
        "SMTP_HOST": "smtp.qq.com",
        "SMTP_PORT": "587",
        "SMTP_USER": "3347606286@qq.com",
        "SMTP_PASS": "fadskwtcdcqfcjie",
        "FROM_EMAIL": "3347606286@qq.com",
        "FROM_NAME": "XTJ 通知",
        "ADMIN_NOTIFY_EMAIL": "3347606286@qq.com"
      }
    },
    "filesystem": {
      "label": "文件系统",
      "description": "项目文件的 AI 读写管理",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    }
  }
}
