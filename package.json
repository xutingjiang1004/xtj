  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "iconv-lite": "^0.7.2",
    "sharp": "^0.34.5",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "alipay-sdk": "^4.14.0"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "terser": "^5.48.0"
  }
}
